<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
 android:baselineAligned="false" android:background="@drawable/widget_surface" android:clipToOutline="true" android:tag="widget-compact">
 <LinearLayout android:id="@+id/widget_active" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:baselineAligned="false">
  <ImageView android:id="@+id/widget_strip" android:layout_width="match_parent" android:layout_height="24dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
  <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="2dp" android:paddingBottom="2dp">
   <FrameLayout android:id="@+id/widget_configure" android:layout_width="56dp" android:layout_height="match_parent" android:contentDescription="切换胶卷" android:focusable="true">
    <LinearLayout android:layout_width="56dp" android:layout_height="82dp" android:layout_gravity="center" android:orientation="vertical" android:gravity="center" android:baselineAligned="false" android:background="@drawable/widget_secondary">
     <ImageView android:id="@+id/widget_logo_small" android:layout_width="48dp" android:layout_height="10dp" android:visibility="gone" android:scaleType="fitCenter" android:importantForAccessibility="no" />
     <ImageView android:id="@+id/widget_cover" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginTop="2dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
     <ImageView android:id="@+id/widget_count" android:layout_width="48dp" android:layout_height="20dp" android:layout_marginTop="2dp" android:scaleType="fitCenter" />
    </LinearLayout>
   </FrameLayout>
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="6dp" android:orientation="vertical" android:baselineAligned="false">
    <LinearLayout android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:baselineAligned="false">
     <ImageView android:id="@+id/widget_logo" android:layout_width="match_parent" android:layout_height="18dp" android:scaleType="fitStart" android:importantForAccessibility="no" />
     <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="胶片随记" android:textColor="@color/ui_ink" android:textStyle="bold" android:textSize="14sp" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
     <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ui_muted" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_actions" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:baselineAligned="false">
     <TextView android:id="@+id/widget_action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:text="记录" android:textColor="@color/ui_on_accent" android:background="@drawable/widget_primary" android:textSize="13sp" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
     <TextView android:id="@+id/widget_meter" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="6dp" android:gravity="center" android:text="测光" android:textColor="@color/ui_ink" android:background="@drawable/widget_secondary" android:textSize="13sp" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>
<LinearLayout android:baselineAligned="false" android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" android:orientation="vertical" android:gravity="center" android:visibility="gone">
 <TextView android:id="@+id/widget_empty_heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="桌面随记" android:textSize="14sp" android:textColor="@color/ui_ink" android:includeFontPadding="false" />
<TextView android:id="@+id/widget_empty_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="没有拍摄中的胶卷" android:textSize="11sp" android:textColor="@color/ui_muted" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" /><LinearLayout android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp"><TextView android:id="@+id/widget_start" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:text="开始新胶卷" android:textSize="13sp" android:textColor="@color/ui_on_accent" android:background="@drawable/widget_primary" android:includeFontPadding="false" android:maxLines="2" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"  /><TextView android:id="@+id/widget_empty_choose" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:text="选择已有胶卷" android:textSize="13sp" android:textColor="@color/ui_ink" android:background="@drawable/widget_secondary" android:includeFontPadding="false" android:maxLines="2" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" android:layout_marginStart="8dp" /></LinearLayout></LinearLayout></LinearLayout>
