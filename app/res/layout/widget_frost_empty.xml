<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:baselineAligned="false" android:padding="12dp" android:gravity="center" android:visibility="gone">
    <TextView android:id="@+id/widget_empty_heading" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="桌面随记" android:textSize="16sp" android:textColor="@color/widget_frost_ink" />
    <TextView android:id="@+id/widget_empty_note" android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textSize="12sp" android:textColor="@color/widget_frost_muted" android:maxLines="2" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:baselineAligned="false">
        <TextView android:id="@+id/widget_start" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="开始新胶卷" android:gravity="center" android:textSize="13sp" android:textColor="@color/widget_frost_on_primary" android:background="@drawable/widget_frost_primary" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/widget_empty_choose" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="选择已有胶卷" android:gravity="center" android:textSize="13sp" android:textColor="@color/widget_frost_ink" android:background="@drawable/widget_frost_secondary" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
</LinearLayout>
