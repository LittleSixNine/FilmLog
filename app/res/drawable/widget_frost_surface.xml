<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Static edge falloff: no wallpaper capture, blur pass or bitmap allocation. -->
    <item android:top="4dp"><shape><solid android:color="@color/widget_frost_shadow_soft"/><corners android:radius="27dp"/></shape></item>
    <item android:left="1dp" android:top="3dp" android:right="1dp" android:bottom="1dp"><shape><solid android:color="@color/widget_frost_shadow"/><corners android:radius="27dp"/></shape></item>
    <item android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="4dp"><shape>
        <gradient android:angle="315" android:startColor="@color/widget_frost_surface_top" android:endColor="@color/widget_frost_surface_bottom"/>
        <stroke android:width="1dp" android:color="@color/widget_frost_edge"/><corners android:radius="26dp"/>
    </shape></item>
</layer-list>
