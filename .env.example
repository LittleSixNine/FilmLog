# Set these in the shell or a local ignored .local.env file.
# Use an existing keystore for an app that is already installed.
# JAVA_HOME=/path/to/jdk
# BUILD_TOOLS=/path/to/android-sdk/build-tools/35.0.0
# ANDROID_JAR=/path/to/android-sdk/platforms/android-35/android.jar
# KEYSTORE=/path/outside/repository/signing.p12
# KEYSTORE_PASSWORD must be supplied securely through the environment.
# BUILD_DIR=/path/outside/repository/build
